# Doit correspondre au ROS_DOMAIN_ID défini dans le .env du wrapper caméra (orbbec_ros2)
ROS_DOMAIN_ID=2

# Network Mode (Options: robot, local)
# "local" = dev sur une seule machine (recommandé par défaut pour tester)
# "robot" = déploiement réel sur le robot avec réseau multi-machines
DEPLOYMENT_ENV=local